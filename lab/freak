#!/usr/bin/env python3
"""freak: play, measure and look up sounds on the emulated MicroFreak.

  freak engines                         oscillator types and what their three knobs are called
  freak play engine=SawX wave=30 ...    set a patch, play a note, record and measure it
                                        (--name idea1 --about "what it is meant to be": shown on the listening page)
  freak piece claudes_sonnet            play a whole multi-part piece from lab/pieces/ and mix it
  freak analyze FILE --note C3          measure any recording
  freak find --word hollow --engine V.Analog --where "centroid_harm<3"
  freak match FILE --note C3            measured oscillator settings that sound closest to a recording
  freak knob cutoff 60                  what the screen shows with a knob at 60 %
  freak sweep osc|filter|env|mod|panel|all  rebuild the knowledge base (minutes)
  freak guide                           regenerate kb/GUIDE.md from the measurements
  freak selftest                        check the emulator still behaves as the tools assume

Patch fields for `play` (knobs are percent of travel, 0-100; filter_amount is -100..100):
  engine wave timbre shape cutoff resonance filter=lp|bp|hp attack decay sustain filter_amount
  amp_mod=on|off cyc_mode=env|run|loop cyc_rise cyc_fall cyc_hold cyc_amount glide paraphonic=on|off
Modulation fields for `play`:
  SOURCE:DEST=AMOUNT   a matrix point, -100..100, e.g. lfo:cutoff=12 env:pitch=-5 key_arp:cutoff=100
                       sources cyc_env env lfo pressure key_arp; destinations pitch wave timbre cutoff assign1-3
  assign1=resonance    what an Assign column points at (wave timbre shape cutoff resonance attack decay sustain
                       cyc_rise cyc_fall cyc_hold cyc_amount glide lfo_rate)
  lfo_shape=sine|tri|saw|square|random|glide  lfo_rate=0-100  lfo_sync=on|off  lfo_div=1/4  lfo_retrig=off|on|legato
  press_mode=velocity|aftertouch  key_mode=linear|random
Fields left out keep the plain starting patch. Add init=no to keep whatever the last patch was (same run only).
"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from freaklab import analyze, engines, kb, matrix, patch  # noqa: E402
from freaklab import panel as panel_text  # noqa: E402
from freaklab.client import Lab, note_hz, note_number  # noqa: E402

OUT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "out")


def parse_fields(pairs):
    fields = {}
    for pair in pairs:
        if "=" not in pair:
            sys.exit(f"'{pair}' is not field=value")
        key, value = pair.split("=", 1)
        key = key.strip().lower()
        if ">" in key or ":" in key:
            try:
                fields[">".join(matrix.parse_point(key))] = float(value)
            except (matrix.MatrixError, ValueError) as e:
                sys.exit(str(e))
        elif key in ("engine", "filter", "cyc_mode", "lfo_shape", "lfo_div", "lfo_retrig", "press_mode", "key_mode",
                     "assign1", "assign2", "assign3"):
            fields[key] = value.strip() if key in ("engine", "lfo_div") else value.strip().lower()
        elif key in ("amp_mod", "paraphonic", "lfo_sync"):
            fields[key] = value.strip().lower() in ("on", "1", "true", "yes")
        else:
            try:
                fields[key] = float(value)
            except ValueError:
                sys.exit(f"{key}={value}: expected a number")
    return fields


def cmd_engines(args):
    for name, index, _cc, labels, faithful in engines.ENGINES:
        note = "" if faithful else "   (not measured: needs Arturia's samples or a microphone, see docs)"
        print(f"{name:13s} wave={labels[0]:9s} timbre={labels[1]:9s} shape={labels[2]:9s}{note}")


def cmd_play(args):
    fields = parse_fields(args.fields)
    os.makedirs(OUT, exist_ok=True)
    base = os.path.join(OUT, args.name)
    hz = note_hz(args.note)
    with Lab() as lab:
        patch.apply(lab, patch.INIT)
        try:
            back, shown, panel = panel_text.set_and_describe(lab, fields)
        except patch.PatchError as e:
            sys.exit(str(e))
        patch.play(lab, args.note, args.hold, args.release, velocity=args.velocity,
                   wav=base + ".wav", raw_wav=base + ".osc.wav")
    osc = analyze.analyze_file(base + ".osc.wav", hz, args.hold, oscillator_only=True)
    out = analyze.analyze_file(base + ".wav", hz, args.hold)
    if any(k in back["matrix"] for k in ("lfo>pitch", "cyc_env>pitch")):
        # a moving pitch smears every harmonic across the spectrum, which the pitched-or-noisy
        # measure would read as noise: withdraw that figure rather than report it
        for f in (osc, out):
            if not f.get("silent"):
                f["words"] = [w for w in f.get("words", []) if "noise" not in w] + ["pitch moves while held"]
                f["harmonic_share"] = None
    result = {"patch": back, "screen": shown, "note": args.note, "note_hz": round(hz, 2),
              "oscillator": osc, "output": out,
              "files": {"output": base + ".wav", "oscillator_only": base + ".osc.wav"}}
    env = {k: out.get(k) for k in ("attack_ms", "decay_half_ms", "sustain_ratio", "release_ms") if out.get(k) is not None}
    result["panel"] = panel
    save_card(base, args, fields, panel, hz, osc, out, env)
    if args.json:
        print(json.dumps(result))
        return
    print("On the panel:")
    for line in panel:
        print("  " + line)
    print(f"Note {args.note} ({hz:.1f} Hz), held {args.hold} ms")
    print("Oscillator (exact):  " + analyze.summary(osc))
    print("After filter + amp (filter is a model): " + analyze.summary(out))
    print(f"Loudness over time: {env}")
    print(f"Files: {base}.wav  {base}.osc.wav")
    print(f"Listen: http://rack.local:8770/#{args.name}  (the listening page, if its service is running)")


def save_card(base, args, fields, panel, hz, osc, out, env):
    """Write what the listening page shows beside a render: the panel settings and the headline measurements."""
    import datetime

    def brief(f):
        if f.get("silent"):
            return {"silent": True}
        return {"words": f.get("words", []), "harmonics_db": [round(v, 1) for v in f.get("harmonics_db", [])[:16]],
                "centroid_harm": f.get("centroid_harm"), "centroid_hz": f.get("centroid_hz"),
                "harmonic_share": f.get("harmonic_share"), "odd_even_db": f.get("odd_even_db"),
                "level_db": f.get("level_db"), "summary": analyze.summary(f)}

    card = {"name": args.name, "made": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
            "about": args.about or "", "note": str(args.note), "note_hz": round(hz, 2),
            "hold_ms": args.hold, "release_ms": args.release, "velocity": args.velocity,
            "asked": " ".join(args.fields), "panel": panel,
            "oscillator": brief(osc), "output": brief(out), "loudness": env}
    with open(base + ".json", "w") as fh:
        json.dump(card, fh, indent=1)


def cmd_analyze(args):
    hz = args.hz or note_hz(args.note)
    f = analyze.analyze_file(args.file, hz, args.hold)
    print(json.dumps(f) if args.json else analyze.summary(f))
    if not args.json:
        print({k: f.get(k) for k in ("f0_hz", "cents_off", "level_db", "rolloff85_hz", "bands_db", "am_depth",
                                     "am_rate_hz", "centroid_wobble", "attack_ms", "sustain_ratio", "release_ms")})
        print("strongest sine waves (ratio to the note, dB):", f.get("peaks"))


def _print_hits(rows):
    for dist, table, p in rows:
        lead = f"{dist:5.1f} dB  " if dist is not None else ""
        print(f"{lead}{kb.osc_text(table, p)}")
        print(f"          {', '.join(p.get('words', [])) or 'plain'} | brightness centre at harmonic {p.get('centroid_harm')}"
              f" | harmonic share {p.get('harmonic_share')} | odd/even {p.get('odd_even_db')} dB"
              f" | harmonics 1-8: {' '.join(str(v) for v in p.get('harmonics_db', [])[:8])}")


def cmd_find(args):
    hits = kb.find(args.engine, args.word or (), args.where or (), args.sort, args.limit)
    if not hits:
        print("nothing measured fits all of that")
    _print_hits([(None, t, p) for t, p in hits])


def cmd_match(args):
    hz = args.hz or note_hz(args.note)
    f = analyze.analyze_file(args.file, hz, args.hold)
    print("target: " + analyze.summary(f))
    print("closest measured oscillator settings (average spectrum gap, smaller is closer):")
    _print_hits(kb.match(f, args.engine, args.limit))


def cmd_knob(args):
    print(kb.knob_text(args.knob, args.percent))


def cmd_sweep(args):
    from freaklab import calibrate, sweep
    what = args.what
    if what in ("panel", "all"):
        table = calibrate.run()
        os.makedirs(kb.KB, exist_ok=True)
        json.dump(table, open(calibrate.OUT, "w"), indent=1)
        print("panel: done")
    if what in ("osc", "all"):
        sweep.sweep_osc(args.engine or None, args.jobs)
    if what in ("filter", "all"):
        sweep.sweep_filter()
    if what in ("env", "all"):
        sweep.sweep_env()
    if what in ("mod", "all"):
        from freaklab import modsweep
        modsweep.run()


def cmd_piece(args):
    import importlib
    from freaklab import score
    try:
        piece = importlib.import_module("pieces." + args.name).build()
    except ModuleNotFoundError:
        sys.exit(f"no piece lab/pieces/{args.name}.py")
    os.makedirs(OUT, exist_ok=True)
    try:
        wav, takes, card = score.render_piece(piece, OUT, args.jobs)
    except patch.PatchError as e:
        sys.exit(str(e))
    print(f"{card['title']}: {card['seconds']} s, {len(card['tracks'])} parts")
    for t in card["tracks"]:
        print(f"  {t['name']:10s} {t['notes']:4d} notes, level {t['level_db']} dB  ({t['role']})")
    print("Tuning of the held notes (cents):", json.dumps(score.check_tuning(piece, takes)))
    print(f"File: {wav}")
    print(f"Listen: http://rack.local:8770/#{piece['name']}")


def cmd_selftest(args):
    from freaklab import ocr, params
    failures = []

    def check(name, ok, detail=""):
        print(("ok    " if ok else "FAIL  ") + name + (f"  ({detail})" if detail else ""))
        if not ok:
            failures.append(name)

    os.makedirs(OUT, exist_ok=True)
    tmp = os.path.join(OUT, "_selftest.osc.wav")
    with Lab() as lab:
        patch.apply(lab, patch.INIT)
        for knob, (cc, param, _bip) in patch.KNOBS.items():
            lab.cc(cc, 37)
            lab.step(80)
            a = params.read(lab, param)
            lab.cc(cc, 91)
            lab.step(80)
            b = params.read(lab, param)
            check(f"MIDI CC {cc} drives {knob}", (a, b) == (9546, 23479), f"read {a}, {b}")
        patch.apply(lab, patch.INIT)
        for eng in engines.ENGINES:
            try:
                patch.set_engine(lab, eng[0])
                lab.enc("wave", 1)
                lab.step(150)
                lab.enc("wave", -1)
                lab.step(200)
                title = ocr.read_screen(lab.oled())["title"]
                check(f"type {eng[0]} selects and the screen says so", title == eng[0], f"screen: {title}")
            except patch.PatchError as e:
                check(f"type {eng[0]} selects", False, str(e))
        # modulation: the matrix, an Assign column, the LFO and the menu
        patch.apply(lab, patch.INIT)
        try:
            for point, amount in (("lfo>cutoff", 12.5), ("env>pitch", -25), ("key_arp>assign3", 100)):
                got = matrix.set_amount(lab, *matrix.parse_point(point), amount)
                check(f"matrix point {point} takes {amount}", abs(got - amount) < 0.15, f"firmware holds {got}")
            check("matrix reads back as set", matrix.amounts(lab) == {"lfo>cutoff": 12.5, "env>pitch": -25.0, "key_arp>assign3": 100.0},
                  str(matrix.amounts(lab)))
            matrix.clear(lab)
            check("matrix clears", matrix.amounts(lab) == {}, str(matrix.amounts(lab)))
            for control in ("resonance", "shape", "cyc_rise"):
                matrix.assign(lab, 1, control)
                check(f"Assign1 points at {control}", matrix.assignments(lab)["assign1"] == control)
            matrix.assign(lab, 1, "shape")
            patch.apply(lab, {"lfo_shape": "square", "lfo_sync": True, "lfo_div": "1/8"})
            back = patch.read_back(lab)
            check("LFO shape, sync and division set", (back["lfo_shape"], back["lfo_sync"], back["lfo_div"]) == ("square", True, "1/8"),
                  str((back["lfo_shape"], back["lfo_sync"], back["lfo_div"])))
            patch.apply(lab, {"lfo_retrig": "on"})
            check("Utility menu sets LFO Retrig", params.read(lab, "LFO.Retrig") == 16384)
            patch.apply(lab, {"lfo_retrig": "off"})
            # an envelope at full sustain on Pitch at 25 is one octave up
            patch.apply(lab, patch.INIT)
            patch.apply(lab, {"engine": "BasicWaves", "wave": 50, "timbre": 0, "shape": 0, "env>pitch": 25})
            patch.play(lab, 57, 600, 0, raw_wav=tmp, cv_every=0)
            f = analyze.analyze_file(tmp, 440.0, 600, oscillator_only=True)
            check("Env > Pitch at 25 is one octave", abs(f.get("cents_off", 99)) < 8, f"{f.get('f0_hz')} Hz for A3 + 12")
        except (patch.PatchError, matrix.MatrixError) as e:
            check("modulation controls", False, str(e))
        patch.apply(lab, patch.INIT)
        patch.apply(lab, {"engine": "BasicWaves", "wave": 50, "timbre": 0, "shape": 0})
        patch.play(lab, 69, 600, 0, raw_wav=tmp, cv_every=0)
    f = analyze.analyze_file(tmp, 440.0, 600, oscillator_only=True)
    check("note 69 is 440 Hz", abs(f.get("cents_off", 99)) < 8, f"{f.get('f0_hz')} Hz")
    check("a sawtooth measures as one", abs(f["harmonics_db"][1] + 6) < 1 and abs(f["harmonics_db"][2] + 9.5) < 1,
          str(f["harmonics_db"][:4]))
    os.remove(tmp)
    sys.exit(1 if failures else 0)


def main():
    ap = argparse.ArgumentParser(prog="freak", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("engines").set_defaults(fn=cmd_engines)
    p = sub.add_parser("play")
    p.add_argument("fields", nargs="*")
    p.add_argument("--note", default="C3")
    p.add_argument("--hold", type=float, default=1000)
    p.add_argument("--release", type=float, default=500)
    p.add_argument("--velocity", type=int, default=100)
    p.add_argument("--name", default="last")
    p.add_argument("--about", help="a sentence on what this sound is meant to be; shown on the listening page")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_play)
    for name, fn in (("analyze", cmd_analyze), ("match", cmd_match)):
        p = sub.add_parser(name)
        p.add_argument("file")
        p.add_argument("--note", default="C3")
        p.add_argument("--hz", type=float)
        p.add_argument("--hold", type=float, default=None, help="ms the note was held, if the file includes the release")
        p.add_argument("--json", action="store_true")
        if name == "match":
            p.add_argument("--engine")
            p.add_argument("--limit", type=int, default=8)
        p.set_defaults(fn=fn)
    p = sub.add_parser("find")
    p.add_argument("--engine")
    p.add_argument("--word", action="append")
    p.add_argument("--where", action="append")
    p.add_argument("--sort")
    p.add_argument("--limit", type=int, default=12)
    p.set_defaults(fn=cmd_find)
    p = sub.add_parser("knob")
    p.add_argument("knob")
    p.add_argument("percent", type=float)
    p.set_defaults(fn=cmd_knob)
    p = sub.add_parser("sweep")
    p.add_argument("what", choices=["osc", "filter", "env", "mod", "panel", "all"])
    p.add_argument("--engine", action="append")
    p.add_argument("--jobs", type=int, default=12)
    p.set_defaults(fn=cmd_sweep)
    p = sub.add_parser("piece")
    p.add_argument("name", help="a file in lab/pieces/, without .py")
    p.add_argument("--jobs", type=int, default=8)
    p.set_defaults(fn=cmd_piece)
    sub.add_parser("selftest").set_defaults(fn=cmd_selftest)
    sub.add_parser("guide").set_defaults(fn=lambda a: print(kb.build_guide()))
    args = ap.parse_args()
    if args.cmd == "play":
        note_number(args.note)
    args.fn(args)


if __name__ == "__main__":
    main()
